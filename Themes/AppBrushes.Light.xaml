<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F6F8FC"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#D9E1EC"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#111827"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6B7280"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#1E40AF"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="Brush.SidebarItemHover" Color="#EEF4FF"/>
    <SolidColorBrush x:Key="Brush.SidebarItemSelected" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#111827"/>
    <SolidColorBrush x:Key="Brush.SidebarTextMuted" Color="#6B7280"/>

    <!-- State -->
    <SolidColorBrush x:Key="Brush.Success" Color="#16A34A"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#DC2626"/>

    <!-- Popup / Scroll -->
    <SolidColorBrush x:Key="Brush.PopupBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PopupItemHover" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="Brush.PopupItemSelected" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#64748B"/>
    <SolidColorBrush x:Key="Brush.ScrollTrack" Color="#E5E7EB"/>
    
    <SolidColorBrush x:Key="Brush.TableRowHover" Color="#EEF4FF"/>
    <SolidColorBrush x:Key="Brush.TableRowSelected" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.TableRowSelectedText" Color="#FFFFFF"/>

</ResourceDictionary>