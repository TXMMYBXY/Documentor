<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#475569"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#1D4ED8"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.SidebarItemHover" Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.SidebarItemSelected" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.SidebarTextMuted" Color="#94A3B8"/>

    <!-- State -->
    <SolidColorBrush x:Key="Brush.Success" Color="#16A34A"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#F87171"/>

    <!-- Popup / Scroll -->
    <SolidColorBrush x:Key="Brush.PopupBackground" Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.PopupItemHover" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.PopupItemSelected" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#64748B"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Brush.ScrollTrack" Color="#0F172A"/>
    
    <SolidColorBrush x:Key="Brush.TableRowHover" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.TableRowSelected" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.TableRowSelectedText" Color="#FFFFFF"/>
    
    <!-- Toast -->
    <SolidColorBrush x:Key="Brush.Toast.SuccessBackground" Color="#0F2A1B"/>
    <SolidColorBrush x:Key="Brush.Toast.SuccessBorder" Color="#1F6A3C"/>

    <SolidColorBrush x:Key="Brush.Toast.ErrorBackground" Color="#2A1216"/>
    <SolidColorBrush x:Key="Brush.Toast.ErrorBorder" Color="#7F1D1D"/>

</ResourceDictionary>