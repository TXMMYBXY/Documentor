<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#475569"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#1D4ED8"/>

    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.SidebarItemHover" Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.SidebarItemSelected" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.SidebarTextMuted" Color="#94A3B8"/>

    <SolidColorBrush x:Key="Brush.Error" Color="#F87171"/>

</ResourceDictionary>