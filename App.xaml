<Application x:Class="Documentor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Documentor.Presentation.ViewModels.Pages"
             xmlns:views="clr-namespace:Documentor.Presentation.Views.Pages"
             xmlns:converters="clr-namespace:Documentor.Presentation.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MahApps.Metro -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />

                <!-- Кисти -->
                <ResourceDictionary Source="Themes/AppBrushes.Light.xaml"/>

                <!-- Стили -->
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Layout.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ComboBox.xaml"/>
                
                
            </ResourceDictionary.MergedDictionaries>
            
            <converters:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:SidebarToggleAlignmentConverter x:Key="SidebarToggleAlignmentConverter"/>
            
            <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}">
                <views:DashboardPageView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:UsersPageViewModel}">
                <views:UsersPageView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DepartmentsPageViewModel}">
                <views:DepartmentsPageView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ContractTemplatesPageViewModel}">
                <views:ContractTemplatesPageView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TemplatesPageViewModel}">
                <views:TemplatesPageView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProfilePageViewModel}">
                <views:ProfilePageView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
                <views:SettingsPageView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:DocumentPageViewModel}">
                <views:DocumentPageView />
            </DataTemplate>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>