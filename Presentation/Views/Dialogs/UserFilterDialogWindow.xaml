<Window x:Class="Documentor.Presentation.Views.Dialogs.UserFilterDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фильтр пользователей"
        Width="420"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Фильтр пользователей"
                   FontSize="20"
                   FontWeight="Bold"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="ФИО"/>
            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Email"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="ID отдела"/>
            <TextBox Text="{Binding DepartmentId, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="8">
            <TextBlock Text="ID роли"/>
            <TextBox Text="{Binding RoleId, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="9" Margin="0,12,0,0">
            <TextBlock Text="Размер страницы"/>
            <TextBox Text="{Binding PageSize, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
        </StackPanel>

        <StackPanel Grid.Row="10"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Сбросить"
                    Command="{Binding ResetCommand}"
                    Margin="0,0,10,0"
                    Padding="12,5"/>

            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,10,0"
                    Padding="12,5"/>

            <Button Content="Применить"
                    Command="{Binding ApplyCommand}"
                    Padding="12,5"/>
        </StackPanel>
    </Grid>
</Window>