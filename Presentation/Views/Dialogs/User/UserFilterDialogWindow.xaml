<mah:MetroWindow x:Class="Documentor.Presentation.Views.Dialogs.UserFilterDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Фильтр пользователей"
                 Width="500"
                 Height="550"
                 MinWidth="500"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 TitleCharacterCasing="Normal"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <Grid Margin="20"
          Background="{DynamicResource Brush.WindowBackground}">
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Фильтр пользователей"
                           Style="{StaticResource PageTitleTextStyle}"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10">
                    <StackPanel>
                        <TextBlock Text="ФИО" Style="{StaticResource FormLabelTextStyle}"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="Email" Style="{StaticResource FormLabelTextStyle}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="Отдел" Style="{StaticResource FormLabelTextStyle}"/>
                        <ComboBox ItemsSource="{Binding Departments}"
                                  SelectedItem="{Binding SelectedDepartment}"
                                  DisplayMemberPath="Title"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Margin="0,0,0,14"/>

                        <TextBlock Text="Роль" Style="{StaticResource FormLabelTextStyle}"/>
                        <ComboBox ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding SelectedRole}"
                                  DisplayMemberPath="Title"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Margin="0,0,0,14"/>

                        <TextBlock Text="Размер страницы" Style="{StaticResource FormLabelTextStyle}"/>
                        <TextBox Text="{Binding PageSize, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Width="120"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Сбросить"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                    <Button Content="Отмена"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"/>

                    <Button Content="Применить"
                            Command="{Binding ApplyCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>