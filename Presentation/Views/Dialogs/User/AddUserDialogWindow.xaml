<mah:MetroWindow x:Class="Documentor.Presentation.Views.Dialogs.User.AddUserDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Добавление пользователя"
                 Width="500"
                 Height="520"
                 MinWidth="500"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 TitleCharacterCasing="Normal"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <Grid Margin="20"
          Background="{DynamicResource Brush.WindowBackground}">
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Добавление пользователя"
                           Style="{StaticResource PageTitleTextStyle}"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10">
                    <StackPanel>
                        <TextBlock Text="Email" Style="{StaticResource FormLabelTextStyle}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="ФИО" Style="{StaticResource FormLabelTextStyle}"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="Пароль" Style="{StaticResource FormLabelTextStyle}"/>
                        <PasswordBox x:Name="PasswordInput"
                                     PasswordChanged="PasswordInput_OnPasswordChanged"
                                     Style="{StaticResource InputPasswordBoxStyle}"
                                     Margin="0,0,0,14"/>

                        <TextBlock Text="Роль" Style="{StaticResource FormLabelTextStyle}"/>
                        <ComboBox ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding SelectedRole}"
                                  DisplayMemberPath="Title"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Margin="0,0,0,14"/>

                        <TextBlock Text="Отдел" Style="{StaticResource FormLabelTextStyle}"/>
                        <ComboBox ItemsSource="{Binding Departments}"
                                  SelectedItem="{Binding SelectedDepartment}"
                                  DisplayMemberPath="Title"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Margin="0,0,0,14"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"/>

                    <Button Content="Добавить"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>