<mah:MetroWindow x:Class="Documentor.Presentation.Views.Dialogs.Department.DepartmentEmployeesDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="Сотрудники отдела"
                 Width="900"
                 Height="600"
                 MinWidth="760"
                 MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 TitleCharacterCasing="Normal"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <Grid Margin="20"
          Background="{DynamicResource Brush.WindowBackground}">
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           Style="{StaticResource PageTitleTextStyle}"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2"
                           Text="{Binding EmployeesCount, StringFormat=Всего сотрудников: {0}}"
                           Style="{StaticResource SectionHintTextStyle}"/>

                <!-- Employees table -->
                <Border Grid.Row="4"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Employees}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Style="{StaticResource AppDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО"
                                                    Binding="{Binding FullName}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource AppDataGridTextStyle}"/>

                                <DataGridTextColumn Header="Email"
                                                    Binding="{Binding Email}"
                                                    Width="260"
                                                    ElementStyle="{StaticResource AppDataGridTextStyle}"/>

                                <DataGridTextColumn Header="Роль"
                                                    Binding="{Binding Role}"
                                                    Width="160"
                                                    ElementStyle="{StaticResource AppDataGridTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="В отделе нет сотрудников"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeesCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Footer -->
                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Закрыть"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>