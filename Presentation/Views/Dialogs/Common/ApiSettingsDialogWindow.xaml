<mah:MetroWindow x:Class="Documentor.Presentation.Views.Dialogs.Common.ApiSettingsDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Настройка API"
                 Width="560"
                 SizeToContent="Height"
                 MinHeight="260"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 TitleCharacterCasing="Normal"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <Grid Margin="20"
          Background="{DynamicResource Brush.WindowBackground}">
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Настройка адреса API"
                           Style="{StaticResource PageTitleTextStyle}"/>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Укажите адрес API, который будет использоваться для авторизации и работы приложения."
                               Style="{StaticResource SectionHintTextStyle}"
                               Margin="0,0,0,14"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Адрес API"
                               Style="{StaticResource FormLabelTextStyle}"/>

                    <TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Для возврата к стандартному адресу используйте кнопку «Сбросить»."
                               Style="{StaticResource SectionHintTextStyle}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Brush.Error}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Сбросить"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                    <Button Content="Отмена"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"/>

                    <Button Content="Сохранить"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>