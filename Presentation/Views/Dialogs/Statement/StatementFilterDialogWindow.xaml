<mah:MetroWindow x:Class="Documentor.Presentation.Views.Dialogs.Statement.StatementFilterDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Фильтр шаблонов заявлений"
                 Width="520"
                 SizeToContent="Height"
                 MinHeight="340"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 TitleCharacterCasing="Normal"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Фильтр шаблонов заявлений"
                           Style="{StaticResource PageTitleTextStyle}"/>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Название"
                               Style="{StaticResource FormLabelTextStyle}"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Создатель ID"
                               Style="{StaticResource FormLabelTextStyle}"/>
                    <TextBox Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Создан после"
                               Style="{StaticResource FormLabelTextStyle}"/>
                    <DatePicker SelectedDate="{Binding CreatedAtLater, Mode=TwoWay}"
                                Margin="0,0,0,12"/>

                    <TextBlock Text="Создан до"
                               Style="{StaticResource FormLabelTextStyle}"/>
                    <DatePicker SelectedDate="{Binding CreatedAtEarlier, Mode=TwoWay}"
                                Margin="0,0,0,12"/>

                    <TextBlock Text="Размер страницы"
                               Style="{StaticResource FormLabelTextStyle}"/>
                    <TextBox Text="{Binding PageSize, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Сбросить"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                    <Button Content="Отмена"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"/>

                    <Button Content="Применить"
                            Command="{Binding ApplyCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>