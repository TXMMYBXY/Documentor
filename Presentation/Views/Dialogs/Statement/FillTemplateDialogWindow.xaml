<mah:MetroWindow x:Class="Documentor.Presentation.Views.Dialogs.Statement.FillTemplateDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Заполнение шаблона"
                 Width="640"
                 Height="680"
                 MinWidth="560"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 TitleCharacterCasing="Normal"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </mah:MetroWindow.Resources>

    <Grid Margin="20"
          Background="{DynamicResource Brush.WindowBackground}">
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="{Binding TitleText}"
                           Style="{StaticResource PageTitleTextStyle}"
                           TextWrapping="Wrap"/>

                <!-- Form -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10,0,20,10">
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">

                                    <!-- Label + required (*) without Run binding -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   Style="{StaticResource FormLabelTextStyle}"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Grid.Column="1"
                                                   Text=" *"
                                                   Style="{StaticResource FormLabelTextStyle}"
                                                   Foreground="{DynamicResource Brush.Error}"
                                                   Visibility="{Binding Required, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>

                                    <!-- Text -->
                                    <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Visibility="{Binding IsTextField, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Date -->
                                    <DatePicker SelectedDate="{Binding DateValue, Mode=TwoWay}"
                                                Visibility="{Binding IsDateField, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Checkbox -->
                                    <CheckBox Content="Да / Нет"
                                              IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                              Margin="0,4,0,0"
                                              Visibility="{Binding IsCheckboxField, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Dropdown / ComboBox -->
                                    <ComboBox ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding TextValue, Mode=TwoWay}"
                                              DisplayMemberPath="."
                                              Style="{StaticResource ComboBoxStyle}"
                                              Visibility="{Binding IsSelectField, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Unsupported -->
                                    <TextBlock Text="Тип поля пока не поддерживается"
                                               Foreground="{DynamicResource Brush.Error}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsUnsupported, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Field validation -->
                                    <TextBlock Text="{Binding ValidationMessage}"
                                               Foreground="{DynamicResource Brush.Error}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Brush.Error}"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Отмена"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0"/>

                        <Button Content="Отправить"
                                Command="{Binding SubmitCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>