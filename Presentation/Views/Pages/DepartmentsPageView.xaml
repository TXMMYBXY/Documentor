<UserControl x:Class="Documentor.Presentation.Views.Pages.DepartmentsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             PreviewKeyDown="Root_OnPreviewKeyDown"
             MouseDown="Root_OnMouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="{Binding ActiveFilterSummary}"
                           Style="{StaticResource SectionHintTextStyle}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding TotalCount, StringFormat=Всего: {0}}"
                       Style="{StaticResource SectionHintTextStyle}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Add -->
                    <Button Grid.Column="0"
                            Command="{Binding AddDepartmentCommand}"
                            ToolTip="Добавить отдел">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Width" Value="42"/>
                                <Setter Property="MinWidth" Value="42"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </Button.Style>
                        <iconPacks:PackIconMaterial Kind="DomainPlus"
                                                    Width="18"
                                                    Height="18"/>
                    </Button>

                    <!-- Filter -->
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding OpenFilterCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinWidth" Value="120"/>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FilterOutline"
                                                            Width="16"
                                                            Height="16"
                                                            Margin="0,0,8,0"/>
                                <TextBlock Text="Фильтр"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Command="{Binding ClearFilterCommand}"
                                ToolTip="Сбросить фильтр">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Width" Value="42"/>
                                    <Setter Property="MinWidth" Value="42"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="1,0,0,0"/>
                                </Style>
                            </Button.Style>
                            <iconPacks:PackIconMaterial Kind="Close"
                                                        Width="16"
                                                        Height="16"/>
                        </Button>
                    </Grid>

                    <!-- Refresh -->
                    <Button Grid.Column="4"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Обновить список">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Обновить"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Lower actions -->
                <WrapPanel Grid.Row="2">
                    <Button Command="{Binding EditDepartmentCommand}"
                            Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PencilOutline"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Редактировать"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteDepartmentCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Background" Value="#C62828"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#C62828"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="DeleteOutline"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Удалить"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Data -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <DataGrid x:Name="DepartmentsGrid"
                          ItemsSource="{Binding Departments}"
                          SelectedItem="{Binding SelectedDepartment}"
                          IsReadOnly="True"
                          Sorting="DepartmentsGrid_OnSorting"
                          Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название"
                                            Binding="{Binding Title}"
                                            Width="220"
                                            SortMemberPath="Title"
                                            ElementStyle="{StaticResource AppDataGridTextStyle}"/>

                        <DataGridTextColumn Header="Описание"
                                            Binding="{Binding Description}"
                                            Width="*"
                                            ElementStyle="{StaticResource AppDataGridTextStyle}"/>

                        <DataGridTextColumn Header="Кол-во сотрудников"
                                            Binding="{Binding EmployeesCount}"
                                            Width="150"
                                            SortMemberPath="EmployeesCount"
                                            ElementStyle="{StaticResource AppDataGridTextStyle}"/>

                        <DataGridTemplateColumn Header="Сотрудники"
                                                Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="EmployeesButton_OnClick"
                                            ToolTip="Показать сотрудников отдела">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Width" Value="36"/>
                                                <Setter Property="MinWidth" Value="36"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                            </Style>
                                        </Button.Style>
                                        <iconPacks:PackIconMaterial Kind="AccountGroupOutline"
                                                                    Width="16"
                                                                    Height="16"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="Отделы не найдены"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Paging -->
        <Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}"
                Padding="12">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Command="{Binding PreviousPageCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Width" Value="40"/>
                            <Setter Property="MinWidth" Value="40"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,12,0"/>
                        </Style>
                    </Button.Style>
                    <iconPacks:PackIconMaterial Kind="ChevronLeft"
                                                Width="18"
                                                Height="18"/>
                </Button>

                <TextBlock Text="{Binding CurrentPage, StringFormat=Страница {0}}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}"/>

                <TextBlock Text="{Binding TotalPages, StringFormat=из {0}}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>

                <Button Command="{Binding NextPageCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Width" Value="40"/>
                            <Setter Property="MinWidth" Value="40"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </Button.Style>
                    <iconPacks:PackIconMaterial Kind="ChevronRight"
                                                Width="18"
                                                Height="18"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Error -->
        <TextBlock Grid.Row="7"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource Brush.Error}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>