<UserControl x:Class="Documentor.Presentation.Views.Pages.DepartmentsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="{Binding ActiveFilterSummary}"
                           Style="{StaticResource SectionHintTextStyle}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding TotalCount, StringFormat=Всего: {0}}"
                       Style="{StaticResource SectionHintTextStyle}"
                       VerticalAlignment="Center"/>
        </Grid>
        
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верхняя строка -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Добавить -->
                    <Button Grid.Column="0"
                            Command="{Binding AddUserCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Добавить пользователя"
                            Width="42"
                            MinWidth="42"
                            Padding="0"
                            Margin="0">
                        <iconPacks:PackIconMaterial Kind="HomePlus"
                                                    Width="18"
                                                    Height="18"/>
                    </Button>

                    <!-- Фильтр + сброс -->
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding OpenFilterCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0"
                                MinWidth="120">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FilterOutline"
                                                            Width="16"
                                                            Height="16"
                                                            Margin="0,0,8,0"/>
                                <TextBlock Text="Фильтр"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Command="{Binding ClearFilterCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="42"
                                MinWidth="42"
                                Padding="0"
                                Margin="1,0,0,0"
                                ToolTip="Сбросить фильтр">
                            <iconPacks:PackIconMaterial Kind="Close"
                                                        Width="16"
                                                        Height="16"/>
                        </Button>
                    </Grid>

                    <!-- Обновить -->
                    <Button Grid.Column="4"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0"
                            ToolTip="Обновить список">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Обновить"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Вторая строка -->
                <WrapPanel Grid.Row="2">
                    <Button Command="{Binding EditUserCommand}"
                            Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PencilOutline"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Редактировать"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding DeleteUserCommand}"
                            Background="#C62828"
                            Foreground="White"
                            BorderBrush="#C62828"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="DeleteOutline"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Удалить"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>
        
        <!-- Data -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <DataGrid x:Name="UsersGrid"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название"
                                            Binding="{Binding Title}"
                                            Width="220"/>
                        <DataGridTextColumn Header="Описание"
                                            Binding="{Binding Description}"
                                            Width="260"/>
                        <DataGridTextColumn Header="Роль"
                                            Binding="{Binding Role}"
                                            Width="140"/>
                        <DataGridTextColumn Header="Отдел"
                                            Binding="{Binding Department}"
                                            Width="220"/>
                        <DataGridCheckBoxColumn Header="Активен"
                                                Binding="{Binding IsActive}"
                                                Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="Пользователи не найдены"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                </Border>
            </Grid>
        </Border>
        
    </Grid>
</UserControl>