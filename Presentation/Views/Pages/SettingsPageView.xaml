<UserControl x:Class="Documentor.Presentation.Views.Pages.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource PageTitleTextStyle}"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Тема приложения"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Светлая"
                            Command="{Binding SetLightThemeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <Button Content="Тёмная"
                            Command="{Binding SetDarkThemeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>