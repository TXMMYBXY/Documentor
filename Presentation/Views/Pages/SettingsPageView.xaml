<UserControl x:Class="Documentor.Presentation.Views.Pages.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid>
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Настройки"
                           Style="{StaticResource PageTitleTextStyle}"
                           Margin="0,0,0,20"/>

                <!-- Theme -->
                <TextBlock Text="Тёмная тема"
                           Style="{StaticResource FormLabelTextStyle}"/>

                <mah:ToggleSwitch IsOn="{Binding IsDarkTheme, Mode=TwoWay}"
                                  OnContent="Включена"
                                  OffContent="Выключена"
                                  Margin="0,0,0,24"
                                  HorizontalAlignment="Left"/>

                <!-- Pagination -->
                <StackPanel Width="420"
                            HorizontalAlignment="Left">
                    <TextBlock Text="Количество записей на странице"
                               Style="{StaticResource FormLabelTextStyle}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,0"
                                VerticalAlignment="Center">
                        <Slider Minimum="{Binding MinPageSize}"
                                Maximum="{Binding MaxPageSize}"
                                TickFrequency="{Binding PageSizeTickFrequency}"
                                IsSnapToTickEnabled="True"
                                AutoToolTipPlacement="TopLeft"
                                AutoToolTipPrecision="0"
                                SmallChange="{Binding PageSizeTickFrequency}"
                                LargeChange="10"
                                Value="{Binding SelectedPageSize, Mode=TwoWay}"
                                Width="280"
                                VerticalAlignment="Center"/>

                        <Border Width="90"
                                Height="40"
                                Margin="16,0,0,0"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding SelectedPageSize}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedPageSize, StringFormat=Текущее значение: {0}}"
                               Style="{StaticResource SectionHintTextStyle}"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="Используется для всех страниц со списками."
                               Style="{StaticResource SectionHintTextStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>