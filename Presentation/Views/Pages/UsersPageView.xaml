<UserControl x:Class="Documentor.Presentation.Views.Pages.UsersPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="{Binding ActiveFilterSummary}"
                           Style="{StaticResource SectionHintTextStyle}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding TotalCount, StringFormat=Всего: {0}}"
                       Style="{StaticResource SectionHintTextStyle}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
            <WrapPanel>
                <Button Content="Фильтр"
                        Command="{Binding OpenFilterCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                <Button Content="Сбросить фильтр"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                <Button Content="Обновить"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                <Button Content="Сменить статус"
                        Command="{Binding ChangeStatusCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                <Button Content="Удалить"
                        Command="{Binding DeleteUserCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>

        <!-- Table -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            Width="220"/>
                        <DataGridTextColumn Header="ФИО"
                                            Binding="{Binding FullName}"
                                            Width="260"/>
                        <DataGridTextColumn Header="Роль"
                                            Binding="{Binding Role}"
                                            Width="140"/>
                        <DataGridTextColumn Header="Отдел"
                                            Binding="{Binding Department}"
                                            Width="220"/>
                        <DataGridCheckBoxColumn Header="Активен"
                                                Binding="{Binding IsActive}"
                                                Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#CCFFFFFF"
                        CornerRadius="10"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="Пользователи не найдены"
                               FontWeight="Bold"
                               FontSize="14"/>
                </Border>
            </Grid>
        </Border>

        <!-- Paging -->
        <Border Grid.Row="6"
                Style="{StaticResource CardBorderStyle}"
                Padding="12">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="Назад"
                        Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,12,0"/>

                <TextBlock Text="{Binding CurrentPage, StringFormat=Страница {0}}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontWeight="SemiBold"/>

                <TextBlock Text="{Binding TotalPages, StringFormat=из {0}}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{StaticResource Brush.TextSecondary}"/>

                <Button Content="Вперёд"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0"/>
            </StackPanel>
        </Border>

        <!-- Error -->
        <TextBlock Grid.Row="7"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource Brush.Error}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>