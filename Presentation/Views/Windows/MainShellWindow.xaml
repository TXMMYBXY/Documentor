<Window x:Class="Documentor.Presentation.Views.Windows.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Documentor"
        Width="1280"
        Height="800"
        Background="{DynamicResource Brush.WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource Brush.SidebarBackground}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding UserFullName}"
                               Foreground="{DynamicResource Brush.SidebarText}"
                               FontSize="24"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding RoleTitle}"
                               Foreground="{DynamicResource Brush.SidebarTextMuted}"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Department}"
                               Foreground="{DynamicResource Brush.SidebarTextMuted}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Command="{Binding Command}"
                                    Style="{StaticResource SidebarMenuButtonStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Row="3"
                        Content="Выйти"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</Window>