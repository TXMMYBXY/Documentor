<mah:MetroWindow x:Class="Documentor.Presentation.Views.Windows.MainShellWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             Title="Documentor"
             Width="1280"
             Height="800"
             TitleCharacterCasing="Normal"
             WindowStartupLocation="CenterScreen"
             GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
             BorderThickness="1">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.SidebarBackground}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource Brush.SidebarText}"
                               FontSize="24"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Command="{Binding Command}"
                                    Style="{StaticResource SidebarMenuButtonStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Row="3"
                        Content="Выйти"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="20">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</mah:MetroWindow>