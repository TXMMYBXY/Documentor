<mah:MetroWindow x:Class="Documentor.Presentation.Views.Windows.MainShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Documentor"
                 Width="1280"
                 Height="800"
                 TitleCharacterCasing="Normal"
                 WindowStartupLocation="CenterScreen"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <Grid Background="{DynamicResource Brush.WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource Brush.SidebarBackground}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource Brush.SidebarText}"
                               FontSize="24"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Command="{Binding Command}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarMenuButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.SidebarItemSelected}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.SidebarItemSelected}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Row="3"
                        Content="Выйти"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Background="{DynamicResource Brush.WindowBackground}">
            <ContentControl Content="{Binding CurrentPage}"
                            Margin="20"/>
        </Grid>
    </Grid>
</mah:MetroWindow>