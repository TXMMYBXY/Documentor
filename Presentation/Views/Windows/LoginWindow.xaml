<Window x:Class="Documentor.Presentation.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход"
        Width="900"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="460"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.SidebarBackground}">
            <Grid Margin="40">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Documentor"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.SidebarText}"/>

                    <TextBlock Text="Система электронного документооборота"
                               Margin="0,14,0,0"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.SidebarTextMuted}"/>

                    <Border Width="72"
                            Height="4"
                            Margin="0,28,0,0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Accent}"/>

                    <TextBlock Text="Работа с пользователями, шаблонами, задачами и документами в едином рабочем пространстве."
                               Margin="0,28,0,0"
                               FontSize="15"
                               LineHeight="24"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.SidebarTextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Правая часть -->
        <Grid Grid.Column="1">
            <Border Style="{StaticResource LoginCardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>

                    <TextBlock Text="Авторизация"
                               Style="{StaticResource PageTitleTextStyle}"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Введите учётные данные для входа в систему"
                               Style="{StaticResource SectionHintTextStyle}"
                               Margin="0,0,0,28"/>

                    <TextBlock Text="Email"
                               Style="{StaticResource FormLabelTextStyle}"/>

                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,18"/>

                    <TextBlock Text="Пароль"
                               Style="{StaticResource FormLabelTextStyle}"/>

                    <PasswordBox x:Name="PasswordInput"
                                 PasswordChanged="PasswordBox_OnPasswordChanged"
                                 Style="{StaticResource InputPasswordBoxStyle}"
                                 Margin="0,0,0,20"/>

                    <Border BorderBrush="{DynamicResource Brush.Error}"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,20"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource Brush.Error}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Button Content="Войти"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="42"
                            Margin="0"
                            HorizontalAlignment="Stretch"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="120"
                                     Height="6"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="Выполняется вход..."
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>