<UserControl x:Class="Documentor.Presentation.Views.Controls.InAppToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:toasts="clr-namespace:Documentor.Presentation.Services.Toasts"
             xmlns:enums="clr-namespace:Documentor.Core.Enums">
    <UserControl.Resources>
        <Style TargetType="Border" x:Key="ToastCardStyle">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <DataTemplate DataType="{x:Type toasts:ToastItemViewModel}">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ToastCardStyle}">
                        <Style.Triggers>

                            <!-- SUCCESS -->
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static enums:NotificationSeverity.Success}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Toast.SuccessBackground}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Toast.SuccessBorder}"/>
                            </DataTrigger>

                            <!-- ERROR -->
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static enums:NotificationSeverity.Error}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Toast.ErrorBackground}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Toast.ErrorBorder}"/>
                            </DataTrigger>

                            <!-- fade in -->
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- fade out -->
                            <DataTrigger Binding="{Binding IsClosing}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ИКОНКА -->
                    <iconPacks:PackIconMaterial Width="20"
                                                Height="20"
                                                VerticalAlignment="Top">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                                <Setter Property="Kind" Value="InformationOutline"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static enums:NotificationSeverity.Success}">
                                        <Setter Property="Kind" Value="CheckCircleOutline"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static enums:NotificationSeverity.Error}">
                                        <Setter Property="Kind" Value="CloseCircleOutline"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"/>

                        <TextBlock Text="{Binding Message}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Хост НЕ перехватывает клики -->
    <Grid IsHitTestVisible="False">
        <ItemsControl ItemsSource="{Binding Notifications}">
            <ItemsControl.ItemsPanel>
                <!-- Уведомления складываем снизу вверх -->
                <ItemsPanelTemplate>
                    <StackPanel VerticalAlignment="Bottom"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>